# ===================================================================
# PORTFOLIO CMS ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env and adjust values for local development or production.
# ===================================================================

# ------------------- SERVER CONFIGURATION -------------------
PORT=5000
NODE_ENV="development" # Set to "production" in production deployments

# ------------------- CORS & ALLOWED ORIGINS -------------------
CLIENT_ORIGIN="http://localhost:5173"
ADMIN_ALLOWED_ORIGINS="http://localhost:5173,https://yourdomain.com"

# ------------------- DATABASE CONFIGURATION -------------------
# Local Development PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ashish_portfolio?schema=public"

# ------------------- ADMIN AUTHENTICATION & SESSIONS -------------------
# WARNING: Change secrets to long random strings in production!
SESSION_SECRET="your-256-bit-crypto-random-session-secret-change-in-production"
JWT_SECRET="your-256-bit-crypto-random-jwt-secret-change-in-production"
ADMIN_SESSION_DURATION=86400 # 24 hours in seconds

# Initial Admin Credentials (Used by seed script & initial login)
ADMIN_EMAIL="dudhatashish1995@gmail.com"
ADMIN_PASSWORD="admin123" # Set strong custom password in production!
ADMIN_NAME="Ashishkumar Dudhat"

# ------------------- MEDIA STORAGE CONFIGURATION -------------------
MAX_UPLOAD_SIZE=10485760 # 10MB limit in bytes
STORAGE_PROVIDER="local" # "local" or "s3"
# AWS_S3_BUCKET="your-production-media-bucket"
# AWS_S3_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"
