# =================================================================
# ASHISHKUMAR DUDHAT PORTFOLIO CMS - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your custom environment values.
# =================================================================

# -----------------------------------------------------------------
# 1. SERVER & NETWORK CONFIGURATION
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
ADMIN_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# -----------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL & PRISMA)
# -----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:admin@localhost:5432/ashish_portfolio?schema=public"

# -----------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY CONFIGURATION
# -----------------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-here"
ADMIN_EMAIL="dudhatashish1995@gmail.com"
ADMIN_PASSWORD="your-strong-admin-password-here"
ADMIN_NAME="Ashishkumar Dudhat"
ADMIN_SESSION_DURATION=86400

# -----------------------------------------------------------------
# 4. STORAGE & FILE UPLOADS CONFIGURATION
# -----------------------------------------------------------------
STORAGE_PROVIDER="local"
STORAGE_PUBLIC_BASE_URL="http://localhost:5000"
MAX_UPLOAD_SIZE=10485760
MAX_RESUME_SIZE_MB=10

# -----------------------------------------------------------------
# 5. REAL EMAIL DISPATCH CONFIGURATION (NODEMAILER SMTP)
# -----------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="dudhatashish1995@gmail.com"
SMTP_PASS="your-16-character-gmail-app-password"
